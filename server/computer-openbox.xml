<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus><focusNew>yes</focusNew><followMouse>no</followMouse></focus>
  <theme><name>Clearlooks</name><titleLayout>NLIMC</titleLayout><keepBorder>yes</keepBorder></theme>
  <desktops><number>1</number><firstdesk>1</firstdesk></desktops>
  <margins><top>0</top><bottom>42</bottom><left>0</left><right>0</right></margins>
  <keyboard/>
  <mouse><context name="Titlebar"><mousebind button="Left" action="Drag"><action name="Move"/></mousebind><mousebind button="Left" action="DoubleClick"><action name="ToggleMaximize"/></mousebind></context></mouse>
  <applications>
    <application class="*"><decor>yes</decor><maximized>no</maximized></application>
  </applications>
</openbox_config>
